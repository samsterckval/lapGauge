# Flash: onboard chip is 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: 8MB octal PSRAM is stacked on the ESP32-S3R8
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# This board exposes a single USB-C that goes straight to the S3's native
# USB. Route console + Serial-equivalent output over USB CDC, not UART.
CONFIG_ESP_CONSOLE_USB_CDC=y

# QSPI LCD DMA transfers benefit from a higher SPI clock ceiling
CONFIG_LCD_ENABLE_DEBUG_LOG=n
